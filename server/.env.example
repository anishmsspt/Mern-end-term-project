# Server Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection
# Set your production or local MongoDB connection URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/unanimous_challenge?retryWrites=true&w=majority
MONGODB_URI=

# In development only, if MONGODB_URI is empty and USE_MEMORY_DB=true,
# an in-memory development MongoDB instance will be used.
# This option is strictly ignored in production mode.
USE_MEMORY_DB=true

# Client URL for CORS
CLIENT_URL=http://localhost:5173

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Optional First-Host Bootstrap CLI Configuration
BOOTSTRAP_HOST_EMAIL=host@unanimous.dev
BOOTSTRAP_HOST_PASSWORD=HostAdmin2026!
BOOTSTRAP_HOST_NAME=Primary Challenge Host
BOOTSTRAP_HOST_LEETCODE=unanimous_host
